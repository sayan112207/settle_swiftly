# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# bun.lock is the lockfile for this project
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment — never commit real credentials. .env.example is the tracked template.
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Supabase CLI local state
supabase/.branches
supabase/.temp
supabase/.env

# AI assistant / editor tooling.
# The specs that used to live in .cursor/rules are preserved, and tracked, in
# docs/project-conventions.md — that content is project documentation, not
# editor config.
#
# .lovable/ is deliberately NOT ignored: project.json identifies this repo to
# Lovable, which syncs from the connected branch (see AGENTS.md).
.claude/
.cursor/

# CodeRabbit skills, fetched from coderabbitai/skills into per-tool directories.
# Ignored with the rest of the assistant config rather than tracked as a
# lockfile would normally be: skills-lock.json only pins content that is itself
# ignored here, and which reviewer each person runs locally is their business.
# Track the lock instead if the team ever needs everyone on identical skill
# versions — the directories stay ignored either way, being fetched output.
.agents/
.aider-desk/
skills-lock.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
