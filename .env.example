# Settle Swiftly — environment template.
# Copy to `.env` and fill in from your Supabase project dashboard.
# `.env` is gitignored. NEVER commit real values.
#
# Supabase is mid-migration on API key naming. Older projects show
# `anon` / `service_role` JWTs; newer ones show `sb_publishable_…` / `sb_secret_…`.
# Either pair works — put whichever your dashboard shows into the same slots.

# ---------------------------------------------------------------------------
# PUBLIC — the VITE_ prefix inlines these into the browser bundle by design.
# Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard → Project Settings → API → Project API keys → `anon` / `public`
# Safe in the browser: every request it makes is still gated by RLS.
VITE_SUPABASE_ANON_KEY=

# Serve the product app from fixtures instead of calling /api/v1.
# Exactly "true" or "false" — anything else fails loudly at startup.
# Leave unset (or "false") to talk to the real API.
VITE_USE_MOCKS=false

# Accounts screens only: set to "true" to keep them on fixtures while the rest
# of the app uses the real API. Unset means "same as VITE_USE_MOCKS".
# VITE_USE_ACCOUNTS_MOCKS=true

# ---------------------------------------------------------------------------
# SECRET — server-side only. Must never reach the browser bundle.
# In production these live in the host's encrypted secrets, not in a file.
# ---------------------------------------------------------------------------

# Dashboard → Project Settings → API → Project API keys → `service_role` / `secret`
# BYPASSES ALL ROW LEVEL SECURITY. Only used where there is no signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supabase CLI — used for `supabase link`, `db push`, `gen types`.
# Not read by the app at runtime.
# ---------------------------------------------------------------------------

# The `<ref>` in https://<ref>.supabase.co, or Dashboard → Project Settings → General
SUPABASE_PROJECT_REF=

# The Postgres password chosen at project creation.
# Resettable at Dashboard → Project Settings → Database → Database password.
SUPABASE_DB_PASSWORD=

# https://supabase.com/dashboard/account/tokens → Generate new token
# Lets the CLI authenticate without an interactive browser login.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# SMTP2GO — sends the chase reminders. Server-only; never VITE_ prefixed.
# ---------------------------------------------------------------------------

# https://app-us.smtp2go.com/sending/apikeys/ → Add API Key
# Grant endpoint permissions, not full access: `/email/send` to send at all,
# and `/activity/search` so a bounce can set contacts.delivery_state without
# waiting on the webhook route that does not exist yet (contract §2.3 — a
# bounce is the provider's verdict, never a user edit).
# Sent as the `X-Smtp2go-Api-Key` request header.
SMTP2GO_API_KEY=

# Optional. SMTP2GO serves regional API hosts and this account is on the US
# dashboard; unset is correct unless sending fails with a region error.
SMTP2GO_API_BASE=
